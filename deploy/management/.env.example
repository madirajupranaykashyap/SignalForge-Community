# Generate with: openssl rand -hex 32
# Inject this value from a secret manager in shared/production environments.
SIGNALFORGE_ADMIN_TOKEN=
MANAGEMENT_BIND=127.0.0.1
MANAGEMENT_PORT=8081

# Optional OIDC tenant-user authentication. Configure all three together.
SIGNALFORGE_OIDC_ISSUER=
SIGNALFORGE_OIDC_AUDIENCE=
SIGNALFORGE_OIDC_JWKS_URL=
SIGNALFORGE_OIDC_TENANT_CLAIM=tenant_id
SIGNALFORGE_OIDC_ROLES_CLAIM=roles
