  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Five-minute rate of log records entering the raw archive branch.",
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "signalforge:input_log_records:rate5m", "legendFormat": "Input records/s", "refId": "A" }
      ],
      "title": "Input log-record rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Five-minute rate of log records remaining after optimization policies.",
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "signalforge:optimized_log_records:rate5m", "legendFormat": "Optimized records/s", "refId": "A" }
      ],
      "title": "Optimized log-record rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Record-count reduction derived from the input and optimized five-minute rates. Negative values indicate optimized throughput exceeded input throughput in the selected window and should be investigated.",
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [
        { "editorMode": "code", "expr": "signalforge:log_record_reduction_percent:rate5m", "legendFormat": "Record reduction", "refId": "A" }
      ],
      "title": "Record-count reduction",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Compare the input and optimized record rates. Rates may be noisy when traffic is idle or sparse.",
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "signalforge:input_log_records:rate5m", "legendFormat": "Input records/s", "refId": "A" },
        { "editorMode": "code", "expr": "signalforge:optimized_log_records:rate5m", "legendFormat": "Optimized records/s", "refId": "B" }
      ],
      "title": "Input vs optimized throughput",
      "type": "timeseries"
    }
  ],
