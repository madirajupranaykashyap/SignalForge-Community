# Pin to a version tag or digest for production.
COLLECTOR_IMAGE=ghcr.io/madirajupranaykashyap/signalforge-collector:latest
COLLECTOR_CONTAINER_NAME=signalforge-collector
ARCHIVE_METRICS_CONTAINER_NAME=signalforge-archive-metrics

# Safe default: accept OTLP only from this host.
OTLP_GRPC_BIND=127.0.0.1
OTLP_GRPC_PORT=4317
OTLP_HTTP_BIND=127.0.0.1
OTLP_HTTP_PORT=4318

# Relative paths are resolved from the directory containing compose.yaml.
ARCHIVE_DIR=./archive

# Prometheus endpoints (loopback-only by default).
METRICS_BIND=127.0.0.1
METRICS_PORT=9464
ARCHIVE_METRICS_BIND=127.0.0.1
ARCHIVE_METRICS_PORT=9465

# Optimization policy defaults. Set a sentinel value such as __disabled__ to
# disable an individual equality rule without editing the Collector config.
SIGNALFORGE_DROP_SEVERITY=DEBUG
SIGNALFORGE_HEALTH_ROUTE=/health
SIGNALFORGE_HEALTH_SERVICE=health-check

# Archive rotation script defaults (used by scripts/archive-rotate.sh).
ARCHIVE_MAX_MB=256
ARCHIVE_RETENTION_DAYS=14

# Optional remote configuration. Leave both blank to use the baked-in local config.
# For remote use, the endpoint must be HTTPS and end with /api/v1/agents/config.
SIGNALFORGE_CONFIG_ENDPOINT=
# Supply via your secret manager, not a committed .env file.
SIGNALFORGE_AGENT_CREDENTIAL=
SIGNALFORGE_POLL_INTERVAL=30s
