# Image to deploy. Pin to a version tag or digest for production.
COLLECTOR_IMAGE=ghcr.io/madirajupranaykashyap/signalforge-collector:latest

# Safe default: accept OTLP only from this host.
# Change to a specific LAN IP only when remote senders need access.
OTLP_GRPC_BIND=127.0.0.1
OTLP_HTTP_BIND=127.0.0.1

# Relative paths are resolved from deploy/collector when using the commands
# in README.md.
ARCHIVE_DIR=./archive
